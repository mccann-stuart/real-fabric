            "confidence": "medium",
            "findingId": "csf_97bf4061f412aea2aab7421c",
            "occurrenceId": "occ_bc0884960b1a354bfec27a78",
            "severity": "medium"
          },
          "ruleId": "privacy.narrow-read-only-microphone",
          "ruleIndex": 5
        },
