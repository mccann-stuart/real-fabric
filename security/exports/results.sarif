            "confidence": "high",
            "findingId": "csf_151e9c838cea65a975baa20d",
            "occurrenceId": "occ_4791b074c4422e58f3f71d66",
            "severity": "medium"
          },
          "ruleId": "resource-exhaustion.unthrottled-open-joins",
          "ruleIndex": 12
        },
